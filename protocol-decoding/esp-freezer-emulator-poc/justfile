# ESP8266 freezer emulator PoC (talks to the real SmartDeviceBox, no freezer attached). `just` lists the recipes.

set shell := ["bash", "-euo", "pipefail", "-c"]

port := env_var_or_default("PORT", "/dev/ttyUSB0")

# list recipes
default:
    @just --list

# check for PlatformIO and fetch the platform
setup:
    #!/usr/bin/env bash
    set -euo pipefail
    main() {
        if ! command -v pio >/dev/null; then
            echo "pio not found. Install: uv tool install platformio  (or: pipx install platformio)" >&2
            exit 1
        fi
        pio --version
        pio pkg install -p espressif8266
    }
    main

# compile the firmware for the NodeMCU
build:
    pio run -e nodemcuv2

# flash the board
flash:
    pio run -e nodemcuv2 -t upload --upload-port {{port}}

# serial monitor (keys: g go, s stop, r restart handshake, v full output, ? help)
monitor:
    pio device monitor -p {{port}} -b 115200

# log the board output to logs/<timestamp>.log (stop with Ctrl-C)
log:
    #!/usr/bin/env bash
    set -euo pipefail
    main() {
        local out="logs/board_$(date +%Y%m%d_%H%M%S).log"
        echo "logging to $out"
        stty -F "{{port}}" 115200 raw -echo
        cat "{{port}}" | tee "$out"
    }
    main

# host unit tests of the freezer core
test:
    pio test -e native

# remove build output
clean:
    pio run -t clean || true
    rm -rf .pio
